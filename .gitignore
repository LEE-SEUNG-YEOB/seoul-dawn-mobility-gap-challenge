# Secrets and local credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
token*.json

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Notebook and editor state
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local-only data and source context must not be tracked by Git
/data/
/docs/context/

# Temporary analysis artifacts and local QA logs
tmp/
temp/
scratch/
outputs/tmp/
outputs/cache/
reports/qa-local/
*.tmp
*.bak
*.log

# Large local databases and downloaded archives
*.sqlite
*.sqlite3
*.db
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# Core instructions must stay trackable.
# Do not add global ignore rules for *.md, *.txt, or *.docx.
!AGENTS.md
!README.md
!.agents/
!.agents/roles/
!.agents/roles/*.md
!prompts/
!prompts/*.md
!docs/
